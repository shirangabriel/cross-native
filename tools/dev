#!/usr/bin/env python3
"""Build/run generated native projects or inspect local prerequisites."""
import argparse
import json
from pathlib import Path
import sys
from project import build, doctor, run_projects


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('command', choices=['doctor', 'build', 'run'])
    parser.add_argument('platform', nargs='?', choices=['ios', 'android', 'all'])
    parser.add_argument('--ios-device', help='iOS simulator UDID or unique name')
    parser.add_argument('--android-device', help='Android serial or AVD name')
    args = parser.parse_args()
    root = Path(__file__).resolve().parent.parent
    if args.command in ('build', 'run') and not args.platform:
        parser.error('build/run requires ios, android, or all')
    config_path = root / '.cross-native/project.json'
    configured = json.loads(config_path.read_text())['platforms'] if config_path.exists() else ['ios', 'android']
    platforms = configured if args.platform == 'all' else ([args.platform] if args.platform else configured)
    if args.command == 'run':
        ok = run_projects(root, platforms, {'ios': args.ios_device, 'android': args.android_device})
    else:
        ok = (build if args.command == 'build' else doctor)(root, platforms)
    return 0 if ok else 1


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, ValueError, KeyError) as exc:
        print(f'Failed: {exc}', file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
