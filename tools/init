#!/usr/bin/env python3
"""Generate, build, and run native starters, then optionally launch a coding agent."""
import argparse
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
from project import generate, build, doctor, run_projects

ADAPTERS = {
    'codex': ('Codex', 'codex'),
    'claude': ('Claude Code', 'claude'),
    'cursor': ('Cursor Agent', 'agent'),
}
CONFIG = '.cross-native/project.json'


def ask(label, default=None, validate=None):
    while True:
        suffix = f' [{default}]' if default else ''
        answer = input(f'{label}{suffix}: ').strip() or default
        if answer and (validate is None or validate(answer)):
            return answer
        print('Please enter a valid value.')


def choice(label, options, default=None):
    print(label)
    keys = list(options)
    for index, key in enumerate(keys, 1):
        suffix = ' (default)' if key == default else ''
        print(f'  {index}. {options[key]}{suffix}')
    default_number = str(keys.index(default) + 1) if default else None
    answer = ask('Choose a number', default_number,
                 lambda value: value in options or (value.isdigit() and 1 <= int(value) <= len(keys)))
    return answer if answer in options else keys[int(answer) - 1]


def valid_id(value):
    # A conservative common subset of Android application IDs and Apple bundle IDs.
    return bool(re.fullmatch(r'[A-Za-z][A-Za-z0-9]*(?:\.[A-Za-z][A-Za-z0-9]*)+', value))


def validate_config(config):
    if not isinstance(config, dict) or config.get('version') != 1:
        raise ValueError('Unsupported project configuration; expected version 1.')
    for field in ('name', 'application_id', 'starting_experience'):
        if not isinstance(config.get(field), str) or not config[field].strip():
            raise ValueError(f'Missing or invalid configuration field: {field}')
    if not valid_id(config['application_id']):
        raise ValueError('Invalid application identifier in saved configuration.')
    platforms = config.get('platforms')
    if not isinstance(platforms, list) or not platforms or any(p not in ('ios', 'android') for p in platforms):
        raise ValueError('Invalid platforms in saved configuration.')
    if config.get('agent') is not None and config['agent'] not in ADAPTERS:
        raise ValueError('Unsupported agent in saved configuration.')
    return config


def collect(selected_agent=None):
    name = ask('App name', validate=lambda value: len(value) <= 80 and value.isprintable())
    platform = choice('Target platforms', {'both': 'iOS and Android', 'ios': 'iOS only', 'android': 'Android only'}, 'both')
    identifier = ask('Application identifier (e.g. com.example.myapp)', validate=valid_id)
    experience = 'A single native screen displaying Hello World.'
    return dict(version=1, name=name, platforms=['ios', 'android'] if platform == 'both' else [platform],
                application_id=identifier, starting_experience=experience, agent=selected_agent)


def save_config(root, config):
    destination = root / CONFIG
    destination.parent.mkdir(parents=True, exist_ok=True)
    # Replace atomically so an interrupted write cannot truncate saved answers.
    fd, temp = tempfile.mkstemp(dir=destination.parent, prefix='.project-', suffix='.tmp')
    try:
        with os.fdopen(fd, 'w') as stream:
            json.dump(config, stream, indent=2)
            stream.write('\n')
        os.replace(temp, destination)
    finally:
        if os.path.exists(temp):
            os.unlink(temp)



def prompt():
    return (
        'Act as the main agent for this Cross Native project. Read AGENTS.md, '
        'workflow/defaults/main.md, workflow/init.md, workflow/project/ customizations, '
        '.cross-native/project.json and specs/project.md when present. '
        'Native starter projects were generated by tools, not agents. Preserve them; '
        'do not regenerate them or invent alternative starter UI. Inspect .build/logs '
        'for build/launch evidence and platform build/evidence for device identity and captures. A successful build is not launch or interaction verification. '
        'Record agreed app requirements in specs/project.md before feature work. '
        'Use dedicated iOS and Android subagents for platform changes and troubleshooting. '
        'If delegation is unavailable report it and provide platform handoff briefs. '
        'Ask the developer what to build next. Do not install system tools, commit, or push automatically.'
    )


def launch_command(agent, executable, root):
    if agent == 'codex':
        return [executable, '--cd', str(root), prompt()]
    if agent == 'cursor':
        return [executable, '--workspace', str(root), prompt()]
    return [executable, prompt()]


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--no-launch', action='store_true', help='Generate/build/run apps without starting an AI agent')
    parser.add_argument('--skip-build', action='store_true', help='Generate projects without building (offline preparation)')
    parser.add_argument('--skip-run', action='store_true', help='Build only; do not launch apps')
    parser.add_argument('--ios-device', help='iOS simulator UDID or unique name')
    parser.add_argument('--android-device', help='Android serial or AVD name')
    parser.add_argument('--agent', choices=ADAPTERS, help='Select or change the agent when resuming')
    args = parser.parse_args(argv)
    root = Path(__file__).resolve().parent.parent
    for required in ('AGENTS.md', 'workflow/defaults/main.md', 'workflow/init.md'):
        if not (root / required).is_file():
            raise ValueError(f'Not a Cross Native project: missing {required} in {root}')
    print(f'Cross Native — project: {root}', flush=True)
    path = root / CONFIG
    if path.exists():
        config = validate_config(json.loads(path.read_text()))
        print('Resuming saved project details. Existing native projects will be preserved.')
        print(f'  {config["name"]} | {", ".join(config["platforms"])} | {config["application_id"]}')
    else:
        config = collect(args.agent)
    if args.agent:
        config['agent'] = args.agent
    validate_config(config)
    save_config(root, config)
    print(f'Saved project details to {CONFIG}.', flush=True)
    generate(root, config)
    doctor(root, config['platforms'])
    if args.skip_build:
        print('Build and device launch skipped; generated apps are unverified.')
    else:
        ok = (build(root, config['platforms']) if args.skip_run else
              run_projects(root, config['platforms'], {'ios': args.ios_device, 'android': args.android_device}))
        if not ok:
            print('Projects and answers saved. Resolve the reported build/device issue, then rerun ./tools/init.', file=sys.stderr)
            return 1
    if args.no_launch:
        print('No agent launched. Run ./tools/init again when ready.')
        return 0
    if not config.get('agent'):
        options = {'none': 'Finish without an agent'}
        options.update({key: f'{label} ({"installed" if shutil.which(binary) else "not found"})'
                        for key, (label, binary) in ADAPTERS.items()})
        selected = choice('Start a coding agent?', options, 'none')
        config['agent'] = None if selected == 'none' else selected
        save_config(root, config)
    if config.get('agent') is None:
        print('Starter ready. Use ./tools/dev run ios|android|all to rebuild and relaunch.')
        return 0
    label, binary = ADAPTERS[config['agent']]
    executable = shutil.which(binary)
    if not executable:
        print(f'{label} CLI ({binary}) was not found on PATH. Install and sign in to it, then rerun ./tools/init.\n'
              'Your answers are saved. Use --agent codex|claude|cursor to switch agents.', file=sys.stderr)
        return 1
    print(f'Launching {label}: {executable}\nWorking directory: {root}\n'
          'The main agent will use the generated projects and saved answers.\n'
          'Subagent availability depends on your agent version and configuration.', flush=True)
    # Inherit the terminal for the interactive session; never evaluate a shell command.
    return subprocess.call(launch_command(config['agent'], executable, root), cwd=root)


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (EOFError, KeyboardInterrupt):
        print('\nInitialization interrupted. Any previously saved answers are retained.', file=sys.stderr)
        sys.exit(130)
    except (OSError, ValueError) as exc:
        print(f'Initialization failed: {exc}', file=sys.stderr)
        sys.exit(1)
